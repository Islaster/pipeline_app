{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:setup": "tsx --env-file=.env src/database/setupDatabase.ts",
    "create-first-manager": "tsx --env-file=.env src/features/auth/scripts/createFirstManager.ts",
    "build": "tsc -p tsconfig.build.json && cp src/database/schema.sql dist/server/src/database/",
    "start": "node dist/server/src/server.js",
    "db:setup:prod": "node dist/server/src/database/setupDatabase.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
